{
  "name": "hands.hinow",
  "version": "0.1.1",
  "description": "hands.hinow.ai: browse any website with hand gestures through the webcam. Chrome MV3 extension for people who cannot use a mouse.",
  "homepage": "https://hands.hinow.ai",
  "repository": { "type": "git", "url": "https://github.com/hinow-ai/hands" },
  "bugs": { "url": "https://github.com/hinow-ai/hands/issues" },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "fetch:model": "node scripts/fetch-model.mjs",
    "art": "python3 scripts/prepare-art.py",
    "package": "node scripts/package.mjs",
    "tiles": "python3 scripts/promo-tiles.py",
    "test": "node tests/run.mjs",
    "test:legacy": "node tests/compare-legacy.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "measure": "node tests/measure.mjs"
  },
  "keywords": [
    "gesture",
    "hand-tracking",
    "mediapipe",
    "accessibility",
    "touchless",
    "chrome-extension"
  ],
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
